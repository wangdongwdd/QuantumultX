{
    "id": "Dong.app.sub",
    "name": "Dong 脚本订阅",
    "author": "@Dong",
    "icon": "https://raw.githubusercontent.com/wangdongwdd/QuantumultX/master/img/zz.png",
    "repo": "https://github.com/wangdongwdd/QuantumultX",
    "desc": "自用脚本合集，数据统一存在 BoxJS 里，随时可以查看和修改。",
    "date": "更新日期：2026-11-25 23:32:00",
    "apps": [
        {
            "id": "ql_sync",
            "name": "BoxJS与青龙数据同步",
            "keys": [
                "ql_sync_keys",
                "ql_sync_notify",
                "@ql.ip",
                "@ql.client_id",
                "@ql.client_secret",
                "@ql.username",
                "@ql.password",
                "@ql.env",
                "@ql.mute",
                "@ql.is_pwd"
            ],
            "settings": [
                {
                    "id": "ql_sync_keys",
                    "name": "需要同步的keys",
                    "val": "",
                    "type": "textarea",
                    "placeholder": "",
                    "autoGrow": true,
                    "rows": 2,
                    "desc": "多个 key 用英文逗号隔开；要加注释就用 @ 分隔，例如：key1@备注,key2"
                },
                {
                    "id": "ql_sync_notify",
                    "name": "是否静默通知",
                    "val": "",
                    "type": "boolean",
                    "placeholder": "true or false",
                    "autoGrow": true,
                    "rows": 1,
                    "desc": "关掉后成功不弹通知，失败还是会提醒"
                },
                {
                    "id": "@ql.is_pwd",
                    "name": "开启密码登陆",
                    "val": false,
                    "type": "boolean",
                    "desc": "打开后优先用账号密码登录青龙"
                },
                {
                    "id": "@ql.ip",
                    "name": "青龙登陆的域名或IP:端口号",
                    "val": "",
                    "type": "text",
                    "placeholder": "111.21.0.32:5700"
                },
                {
                    "id": "@ql.client_id",
                    "name": "应用 Client ID",
                    "val": "",
                    "type": "text"
                },
                {
                    "id": "@ql.client_secret",
                    "name": "应用 Client Secret",
                    "val": "",
                    "type": "text"
                },
                {
                    "id": "@ql.username",
                    "name": "账号",
                    "val": "",
                    "type": "text"
                },
                {
                    "id": "@ql.password",
                    "name": "密码",
                    "val": "",
                    "type": "text"
                }
            ],
            "icons": [
                "https://raw.githubusercontent.com/wangdongwdd/QuantumultX/master/icons/apps/QL_02.png",
                "https://raw.githubusercontent.com/wangdongwdd/QuantumultX/master/icons/apps/QL_02.png"
            ],
            "author": "@Dong",
            "repo": "https://github.com/wangdongwdd/QuantumultX"
        },
        {
            "id": "oil_price",
            "name": "今日油价",
            "keys": [
                "oil_price_region"
            ],
            "descs_html": [
                "填好要查的地区，一键看当天油价"
            ],
            "settings": [
                {
                    "id": "oil_price_region",
                    "name": "今日油价查询地区",
                    "val": "",
                    "type": "textarea",
                    "autoGrow": true,
                    "rows": 1,
                    "desc": "要查的地区名，比如：北京、上海"
                }
            ],
            "icons": [
                "https://raw.githubusercontent.com/wangdongwdd/QuantumultX/master/icons/apps/oil.png",
                "https://raw.githubusercontent.com/wangdongwdd/QuantumultX/master/icons/apps/oil.png"
            ],
            "author": "@Dong",
            "repo": "https://github.com/wangdongwdd/QuantumultX"
        },
        {
            "id": "htaeasy",
            "name": "小区充电桩",
            "keys": [
                "htaeasy_token"
            ],
            "settings": [
                {
                    "id": "htaeasy_token",
                    "name": "HTHC_ACCESS_TOKEN",
                    "val": "",
                    "type": "text",
                    "desc": "进一次充电桩小程序会自动抓取，失效了也可以手动粘贴新的"
                }
            ],
            "icons": [
                "https://raw.githubusercontent.com/wangdongwdd/QuantumultX/master/img/htaeasy.png",
                "https://raw.githubusercontent.com/wangdongwdd/QuantumultX/master/img/htaeasy.png"
            ],
            "author": "@Dong",
            "repo": "https://github.com/wangdongwdd/QuantumultX"
        }
    ]
}